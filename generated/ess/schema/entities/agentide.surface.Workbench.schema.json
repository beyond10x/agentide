{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workbench",
  "x-ess-name": "agentide.surface.Workbench",
  "x-ess-kind": "entity",
  "type": "object",
  "properties": {
    "session_id": {
      "$ref": "#/$defs/agentide.session.SessionId"
    },
    "coding_session_id": {
      "$ref": "#/$defs/agentide.session.SessionId",
      "x-ess-relation": {
        "name": "session",
        "kind": "references",
        "source": "agentide.surface.Workbench",
        "target": "agentide.session.CodingSession",
        "cardinality": "one",
        "via": "coding_session_id"
      }
    },
    "panes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/agentide.surface.PaneSnapshot"
      }
    },
    "focused_pane": {
      "$ref": "#/$defs/agentide.surface.PaneId"
    },
    "open_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/agentide.coding.Path"
      }
    },
    "owner": {
      "type": "string"
    },
    "scopes": {
      "$ref": "#/$defs/agentide.session.SessionScopes"
    },
    "state": {
      "$ref": "#/$defs/agentide.surface.Workbench.State"
    }
  },
  "required": [
    "session_id",
    "coding_session_id",
    "panes",
    "open_files",
    "owner",
    "scopes",
    "state"
  ],
  "additionalProperties": false,
  "x-ess-provenance": {
    "system": "agentide",
    "specification_version": "v1",
    "source_digest": "509495079a366d767a747dbfcd22e419c28040b7ff32d15a1f284393168d16ab",
    "contract_digest": "bdd9d5d646d3812999e9d5c5090b058870a61d7ca2583f343c54b65a5c60ee00",
    "regenerate": "ess generate"
  },
  "$defs": {
    "agentide.coding.Path": {
      "title": "Path",
      "x-ess-name": "agentide.coding.Path",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "agentide.session.SessionId": {
      "title": "SessionId",
      "x-ess-name": "agentide.session.SessionId",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "agentide.session.SessionScopes": {
      "title": "SessionScopes",
      "x-ess-name": "agentide.session.SessionScopes",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "principal": {
          "type": "string"
        },
        "team": {
          "type": "string"
        },
        "project": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "agentide.surface.PaneId": {
      "title": "PaneId",
      "x-ess-name": "agentide.surface.PaneId",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "agentide.surface.PaneKind": {
      "title": "PaneKind",
      "x-ess-name": "agentide.surface.PaneKind",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "Editor",
        "Diff",
        "Terminal",
        "Chat",
        "Timeline",
        "Agents",
        "Approvals",
        "Evidence"
      ]
    },
    "agentide.surface.PaneSnapshot": {
      "title": "PaneSnapshot",
      "x-ess-name": "agentide.surface.PaneSnapshot",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/agentide.surface.PaneId"
        },
        "kind": {
          "$ref": "#/$defs/agentide.surface.PaneKind"
        },
        "title": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/agentide.coding.Path"
        },
        "line": {
          "type": "integer"
        },
        "column": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind",
        "title"
      ],
      "additionalProperties": false
    },
    "agentide.surface.Workbench.State": {
      "title": "State",
      "x-ess-name": "agentide.surface.Workbench.State",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "Active"
      ]
    }
  }
}
