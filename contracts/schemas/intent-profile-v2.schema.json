{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beyond10x.github.io/agentide/contracts/intent-profile-v2.schema.json",
  "title": "AgentIDE actor-aware intent profile v2",
  "type": "object",
  "required": ["format", "rules", "intents"],
  "properties": {
    "format": {"const": "agentide.intent-profile/2"},
    "summary": {"type": "string"},
    "rules": {"type": "object"},
    "intents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "command", "audiences", "port", "effect", "risk", "approval", "subjects"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "command": {"type": "string", "minLength": 1},
          "audiences": {
            "type": "array",
            "items": {"enum": ["human", "agent", "automation"]},
            "minItems": 1,
            "uniqueItems": true
          },
          "port": {"type": "string", "minLength": 1},
          "effect": {"enum": ["observe", "state", "mutate", "execute", "communicate", "external"]},
          "risk": {"enum": ["none", "low", "medium", "high", "critical"]},
          "approval": {"enum": ["never", "required"]},
          "subjects": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
